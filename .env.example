PORT=5000
# Preferred format (recommended, avoids SRV DNS issues on some ISPs/routers):
#   mongodb://user:pass@host1:27017,host2:27017,host3:27017/studenthub?replicaSet=<rs>&authSource=admin&retryWrites=true&w=majority
# Find hosts, replicaSet, and password from the Atlas "Connect" dialog.
# SRV format (may fail with "querySrv ECONNREFUSED" if your DNS blocks SRV records):
#   mongodb+srv://user:pass@cluster0.mongodb.net/studenthub
MONGO_URI=replace-with-your-mongo-uri
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
NODE_ENV=production

# Admin account seeded into the database by: npm run seed
# The password is hashed with bcrypt before being stored.
ADMIN_EMAIL=your-admin-email@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Owner account: no one (including other admins) can change its role or delete it
OWNER_EMAIL=your-owner-email@gmail.com

# Contact page messages are emailed to this address
CONTACT_EMAIL=your-personal-email@gmail.com

# Preferred production email provider: Resend
# Create a domain and API key at https://resend.com
# NOTE: the domain in RESEND_FROM_EMAIL MUST be verified in Resend, otherwise
# every Resend send fails and the code silently falls back to Brevo.
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=onboarding@your-domain.com

# Best no-domain option: Brevo (works on Railway free/Hobby plan, which blocks
# outbound SMTP ports 25/465/587). Free tier = 300 emails/day, no credit card.
# 1) Create an account at https://brevo.com
# 2) Senders & IP -> Senders -> Add a sender (your own Gmail), click the verify link
# 3) SMTP & API -> API Keys -> Generate a new API key (master key)
# 4) Set BREVO_API_KEY and BREVO_FROM_EMAIL (the verified Gmail) on Railway.
# Emails are sent over HTTPS (port 443), which Railway allows on all plans.
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_FROM_EMAIL=your-gmail@gmail.com
BREVO_FROM_NAME=Student Hub Pakistan

# Gmail SMTP fallback. EMAIL_PASS MUST be a 16-character Gmail App Password
# (https://myaccount.google.com/apppasswords) - a normal Gmail password is rejected.
# Tip: EMAIL_USER must be a real, active Gmail account. Emails are sent FROM this account.
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=replace-with-a-gmail-app-password
FROM_NAME=Student Hub Pakistan
ALLOW_DEV_VERIFICATION=false

# Email diagnostics (added for troubleshooting):
#   GET  /api/email/health       -> shows which email providers are configured (no send)
#   POST /api/email/health/test  -> sends a real test email to CONTACT_EMAIL via each provider
# Check the Railway logs (console.error [MAIL] lines) for send results.

# Google OAuth Settings
# Get from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret

# Cloudinary (product file + thumbnail storage)
# Get from https://console.cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Product file storage: 'cloudinary' (persistent, CDN; default) or 'local'
# (server disk). Files over 20MB or when Cloudinary is unset fall back to
# local automatically. On Railway, 'local' storage is ephemeral (lost on redeploy).
FILE_STORAGE=cloudinary

# Comma-separated list of allowed frontend origins (e.g. https://studenthub.vercel.app)
# If empty, CORS is wide open (fine for development, lock it down in production)
CLIENT_ORIGIN=https://your-frontend-domain.vercel.app
