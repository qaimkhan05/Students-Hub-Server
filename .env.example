PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/studenthub
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
NODE_ENV=production

# Admin account seeded into the database by: npm run seed
# The password is hashed with bcrypt before being stored.
ADMIN_EMAIL=your-admin-email@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Owner account: no one (including other admins) can change its role or delete it
OWNER_EMAIL=your-owner-email@gmail.com

# Contact page messages are emailed to this address
CONTACT_EMAIL=your-personal-email@gmail.com

# Email Settings (Gmail)
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=replace-with-a-gmail-app-password
FROM_NAME=Student Hub Pakistan
ALLOW_DEV_VERIFICATION=false

# Google OAuth Settings
# Get from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret

# Cloudinary (product file + thumbnail storage)
# Get from https://console.cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Comma-separated list of allowed frontend origins (e.g. https://studenthub.vercel.app)
# If empty, CORS is wide open (fine for development, lock it down in production)
CLIENT_ORIGIN=https://your-frontend-domain.vercel.app
